# =========================================================
# HelpScan / HelpCopies ERP - Backend Environment Example
# =========================================================

PORT=5002
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://scan.helpcopies.com

# Base de Datos PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=helpcopies_scan
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DB_DIALECT=postgres

# Autenticación JWT
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=24h

# Almacenamiento y Bóveda
STORAGE_ROOT_PATH=./uploads
STORAGE_ROOT=./uploads
DISABLE_INBOX_WATCHER=false
VAULT_ENCRYPTION_ENABLED=true
VAULT_ENCRYPTION_KEY=change_me_32_byte_hex_or_secret

# SFTP / Impresoras FTP
VPS_PUBLIC_IP=
FTP_PUBLIC_HOST=
FTP_PORT=2122
FTP_PLAIN_PORT=2121
FTP_PASSIVE_PORTS=30000-30050
SFTPGO_ADMIN_URL=
SFTPGO_ADMIN_USER=
SFTPGO_ADMIN_PASSWORD=
SFTPGO_STORAGE_ROOT=
SFTPGO_WEBHOOK_SECRET=

# Cola Redis & OCR / IA
REDIS_HOST=localhost
REDIS_PORT=6379
EXTRACTION_MODE=hybrid
OCR_SERVICE_URL=http://localhost:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Correo SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=HelpCopies
SMTP_FROM_EMAIL=no-reply@helpcopies.com
DEMO_REQUEST_TO_EMAIL=

# =========================================================
# Puente de Monitoreo y Seguridad (HelpCopies Monitor)
# =========================================================
# Clave compartida requerida en el header `x-monitor-key`
MONITOR_BRIDGE_KEY=change_me_monitor_bridge_secret
# Token opcional de ipinfo.io (si se omite usa tier gratuito + fallback geoip-lite)
IPINFO_TOKEN=
# Días de retención para limpieza automática de access-logs, logins y errores
SECURITY_LOG_RETENTION_DAYS=60
