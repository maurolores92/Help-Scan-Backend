# =========================================================================
# HC-SCAN Backend - Variables de Entorno de Referencia
# =========================================================================

# Puerto del Backend HTTP
PORT=5002
HOST=0.0.0.0
NODE_ENV=production

# URLs de los frontends autorizados para CORS
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Base de Datos PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=hc_scan
DATABASE_USER=postgres
DATABASE_PASSWORD=helpcopies_pass
DB_DIALECT=postgres

# Clave Secreta para Tokens JWT
JWT_SECRET=cambiar_esta_clave_secreta_jwt_en_produccion
JWT_EXPIRES_IN=8h

# Almacenamiento Multitenant Unificado dentro de uploads/
# Todas las empresas y sus documentos se guardan en uploads/tenancy/company_<id>/
STORAGE_ROOT_PATH=/usr/src/app/uploads
STORAGE_ROOT=/usr/src/app/uploads
DISABLE_INBOX_WATCHER=false

# Cifrado en Reposo de PDFs con AES-256-GCM
VAULT_ENCRYPTION_ENABLED=true
VAULT_ENCRYPTION_KEY=clave_de_cifrado_de_la_boveda_minimo_32_caracteres_o_64_hex

# Integración FTP con Impresoras HP (LaserJet Managed E52645)
# IP pública o dominio de tu VPS donde escuchará el FTP
VPS_PUBLIC_IP=
FTP_PUBLIC_HOST=ftp.helpcopies.com
FTP_PORT=21
FTP_PLAIN_PORT=21
FTP_PASSIVE_PORTS=21000-21005

# Credenciales internas del servicio FTP (SFTPGo)
SFTPGO_ADMIN_URL=http://ftp:8080
SFTPGO_ADMIN_USER=hc_sftp_admin
SFTPGO_ADMIN_PASSWORD=sftp_admin_pass_123
SFTPGO_STORAGE_ROOT=/srv/helpscan/uploads
SFTPGO_WEBHOOK_SECRET=sftpgo_webhook_secret_123

# Extracción de Documentos con Motor OCR Nativo y Microservicio Python
EXTRACTION_MODE=local
OCR_SERVICE_URL=http://ocr:8000

# Redis para cola secuencial
REDIS_HOST=redis
REDIS_PORT=6379
